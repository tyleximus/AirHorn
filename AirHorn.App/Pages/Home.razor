@page "/{FilterName?}"
@using AirHorn.App.Components
@using AirHorn.App.Services
@using AirHorn.Shared.Models
@using Telerik.DataSource 
@using System.Globalization
@inject IAirHornService AirHornService
@inject NavigationManager NavigationManager

<h1>🤑💵💰🪙💸</h1>

<p>Let's Goooooo</p>

<!-- New: Quick-Add Form -->
<EditForm Model="@Form" OnValidSubmit="@OnSubmitAsync" class="mb-3">
  <DataAnnotationsValidator />

  <div class="card shadow-sm">
    <div class="card-body">
      <div class="row g-3 align-items-end">
        <!-- Beneficiaries -->
        <div class="col-12 col-md-4">
          <label class="form-label fw-bold">Beneficiaries</label>
          <div class="d-flex gap-3 flex-wrap">
            <div class="form-check">
              <input class="form-check-input" type="checkbox" id="chkTyler" @bind="isTylerChecked" />
              <label class="form-check-label" for="chkTyler">Tyler</label>
            </div>
            <div class="form-check">
              <input class="form-check-input" type="checkbox" id="chkSierra" @bind="isSierraChecked" />
              <label class="form-check-label" for="chkSierra">Sierra</label>
            </div>
            <div class="form-check">
              <input class="form-check-input" type="checkbox" id="chkAtticus" @bind="isAtticusChecked" />
              <label class="form-check-label" for="chkAtticus">Atticus</label>
            </div>
          </div>
          @if (BeneficiaryValidationError is not null)
          {
            <div class="text-danger small mt-1">@BeneficiaryValidationError</div>
          }
        </div>

        <!-- Amount -->
        <SignedCurrencyInput Id="amount"
                             Label="Amount"
                             CurrencySymbol="$"
                             NegativeByDefault="true"
                             @bind-Value="Form.Amount" />

        <!-- Note -->
        <div class="col-12 col-md-3">
          <label for="note" class="form-label fw-bold">Note</label>
          <InputText id="note" class="form-control" @bind-Value="Form.Note" />
        </div>

        <!-- Date -->
        <div class="col-12 col-md-2">
          <label for="date" class="form-label fw-bold">Date</label>
          <InputDate id="date" class="form-control" @bind-Value="Form.Date" TValue="DateOnly" />
          <ValidationMessage For="@(() => Form.Date)" />
        </div>
      </div>

      <div class="mt-3 d-flex gap-2">
        <button type="submit" class="btn btn-primary">
          <span class="me-1" aria-hidden="true">+</span> Add
        </button>
        <button type="button" class="btn btn-outline-secondary" @onclick="ResetForm">Clear</button>
      </div>
    </div>
  </div>
</EditForm>

<TelerikGrid @ref="GridRef" Data=@MyData EditMode="@EditMode" Pageable="true" OnAdd="@CustomAdd" PageSize="10"
             OnUpdate="@UpdateHandler" OnEdit="@EditHandler" OnDelete="@DeleteHandler" OnCancel="@CancelHandler" OnRowClick="@OnRowClickHandler"
             Sortable="true" FilterMode="@GridFilterMode.FilterRow" FilterRowDebounceDelay="500" Size="@ThemeConstants.Grid.Size.Small" ScrollMode="GridScrollMode.Scrollable" SortMode="SortMode.Multiple">
  <NoDataTemplate>
    <div style="text-align:left;">
      @if (IsLoading)
      {
        <div>
          <img src="/assets/loading.gif" height="37" />
        </div>
      }
      else
      {
        <div>
          No data available
        </div>
      }
    </div>
  </NoDataTemplate>
  <GridAggregates>
    <GridAggregate Field="@nameof(Transaction.Amount)" Aggregate="@GridAggregateType.Sum" FieldType="typeof(Decimal)"></GridAggregate>
  </GridAggregates>
  <GridColumns>
    <GridColumn Field=@nameof(Transaction.TransactionID) Title="ID" Editable="false" Visible="false" />
    <GridColumn Field=@nameof(Transaction.Name) Title="Name" Width="200px" />
    <GridColumn Field=@nameof(Transaction.Amount) Title="Amount" DisplayFormat="{0:C}" Width="200px">
      <FooterTemplate>Total: @context.Sum</FooterTemplate>
    </GridColumn>
    <GridColumn Field=@nameof(Transaction.Note) Title="Note" Width="200px" />
    <GridColumn Field=@nameof(Transaction.Date) Title="Date" Width="200px" />
    <GridCommandColumn Width="250px">
      <GridCommandButton Command="Save" Icon="@SvgIcon.Save" ShowInEdit="true">Update</GridCommandButton>
      <GridCommandButton Command="Edit" Icon="@SvgIcon.Pencil">Edit</GridCommandButton>
      <GridCommandButton Command="Delete" Icon="@SvgIcon.Trash">Delete</GridCommandButton>
      <GridCommandButton Command="Cancel" Icon="@SvgIcon.Cancel" ShowInEdit="true">Cancel</GridCommandButton>
    </GridCommandColumn>
  </GridColumns>
  <GridToolBarTemplate>
    @* No longer needed *@
    <TelerikButton OnClick="CustomAdd" Icon="@SvgIcon.Plus" Visible="false">Add Transaction</TelerikButton>
  </GridToolBarTemplate>
</TelerikGrid>

@code {
  private string? filterName;
  private string? subdomain;
  private const string Tyler = "Tyler";
  private const string Sierra = "Sierra";
  private const string Atticus = "Atticus";

  public List<Transaction>? MyData { get; set; }
  public GridEditMode EditMode { get; set; } = GridEditMode.Inline;
  private TelerikGrid<Transaction>? GridRef { get; set; }
  public bool IsLoading { get; set; } = true;

  // --- Form state ---
  private AddTxForm Form { get; set; } = new();
  private bool isTylerChecked { get; set; }
  private bool isSierraChecked { get; set; }
  private bool isAtticusChecked { get; set; }
  private string? BeneficiaryValidationError { get; set; }

  [Parameter]
  public string? FilterName
  {
    get
    {
      return filterName;
    }
    set
    {
      if (value != String.Empty)
      {
        filterName = value;
      }
      else if (subdomain != null)
      {
        filterName = subdomain;
      }
      else
      {
        filterName = String.Empty;
      }
    }
  }

  protected override async Task OnInitializedAsync()
  {
    var uri = new Uri(NavigationManager.Uri);
    var host = uri.Host.Split('.');
    if (String.IsNullOrEmpty(FilterName) && host != null && host.Length == 4)
    {
      FilterName = $"{host.First().ToUpper().First()}{host.First().Substring(1)}";
    }

    // Pre-check based on current filter (if it matches one of the three)
    isTylerChecked = string.Equals(FilterName, Tyler, StringComparison.OrdinalIgnoreCase);
    isSierraChecked = string.Equals(FilterName, Sierra, StringComparison.OrdinalIgnoreCase);
    isAtticusChecked = string.Equals(FilterName, Atticus, StringComparison.OrdinalIgnoreCase);

    // Default date mirrors your grid behavior
    Form.Date = DateOnly.FromDateTime(DateTime.Today);

    await GetGridData();
    await SetGridOptions();
    IsLoading = false;
  }


  // --- Form submit handler ---
  private async Task OnSubmitAsync()
  {
    BeneficiaryValidationError = null;

    if (Form.Amount is null)
    {
      return; // required validation will show
    }

    var roundedWhole = Form.Amount.Value;
    if (roundedWhole == 0m)
    {
      BeneficiaryValidationError = "Amount must not be zero after rounding.";
      return;
    }

    var note = Form.Note ?? string.Empty;
    var date = Form.Date;

    bool t = isTylerChecked;
    bool s = isSierraChecked;
    bool a = isAtticusChecked;

    var toCreate = new List<Transaction>(capacity: 2);

    // CASES:
    // A) Only Tyler
    if (t && !s && !a)
    {
      toCreate.Add(MakeTx(Tyler, roundedWhole, note, date));
    }
    // B) Only Sierra
    else if (s && !t && !a)
    {
      toCreate.Add(MakeTx(Sierra, roundedWhole, note, date));
    }
    // C) Tyler & Sierra (with or without Atticus), OR only Atticus
    else if ((t && s) || (!t && !s && a))
    {
      var half = roundedWhole / 2m;
      toCreate.Add(MakeTx(Sierra, half, note, date));
      toCreate.Add(MakeTx(Tyler, half, note, date));
    }
    // D) Tyler + Atticus (no Sierra): 75% Tyler, 25% Sierra
    else if (t && a && !s)
    {
      var tAmt = roundedWhole * 0.75m;
      var sAmt = roundedWhole * 0.25m;
      toCreate.Add(MakeTx(Tyler, tAmt, note, date));
      toCreate.Add(MakeTx(Sierra, sAmt, note, date));
    }
    // E) Sierra + Atticus (no Tyler): 75% Sierra, 25% Tyler
    else if (s && a && !t)
    {
      var sAmt = roundedWhole * 0.75m;
      var tAmt = roundedWhole * 0.25m;
      toCreate.Add(MakeTx(Sierra, sAmt, note, date));
      toCreate.Add(MakeTx(Tyler, tAmt, note, date));
    }
    else
    {
      // Should be unreachable, but guard anyway.
      BeneficiaryValidationError = "Invalid selection state.";
      return;
    }

    // Persist one-by-one (as requested)
    foreach (var tx in toCreate)
    {
      await AirHornService.CreateTransaction(tx);
    }

    // Refresh grid & reset form (keep pre-checked defaults)
    await GetGridData();
    ResetForm(keepBeneficiaries: true);
  }

  private Transaction MakeTx(string name, decimal amount, string note, DateOnly date) =>
    new Transaction
    {
      TransactionID = 0,
      Name = name,
      Amount = decimal.Round(amount, 2, MidpointRounding.ToZero), // amounts are exact from whole-dollar base, but clamp to 2dp
      Note = note,
      Date = date
    };

  private void ResetForm() => ResetForm(keepBeneficiaries: false);

  private void ResetForm(bool keepBeneficiaries)
  {
    Form = new AddTxForm
    {
      Amount = null,
      Note = string.Empty,
      Date = DateOnly.FromDateTime(DateTime.Today)
    };
    BeneficiaryValidationError = null;

    if (!keepBeneficiaries)
    {
      isTylerChecked = isSierraChecked = isAtticusChecked = false;
      // Reapply pre-check based on filter if present
      isTylerChecked = string.Equals(FilterName, Tyler, StringComparison.OrdinalIgnoreCase);
      isSierraChecked = string.Equals(FilterName, Sierra, StringComparison.OrdinalIgnoreCase);
      isAtticusChecked = string.Equals(FilterName, Atticus, StringComparison.OrdinalIgnoreCase);
    }
  }

  private static string FormatCurrency(decimal? value) =>
    value is null ? "$0.00" : string.Format(System.Globalization.CultureInfo.CurrentCulture, "{0:C}", value);


  void OnRowClickHandler(GridRowClickEventArgs args)
  {
    var updatedItem = args.Item as Transaction;
    EditItem(updatedItem);
  }

  async Task EditItem(Transaction item)
  {
    var gridState = GridRef.GetState();
    gridState.InsertedItem = null;
    gridState.EditItem = null;
    gridState.OriginalEditItem = null;
    gridState.OriginalEditItem = item;
    gridState.EditItem = item.Clone();
    gridState.EditField = nameof(Transaction.Name);
    await GridRef.SetStateAsync(gridState);
  }

  async Task CancelHandler(GridCommandEventArgs args)
  {
    Console.WriteLine("Cancel event is fired.");
    Transaction item = (Transaction)args.Item;
  }

  async Task CreateHandler(GridCommandEventArgs args)
  {
    Console.WriteLine("Create event is fired.");
    var draftItem = (Transaction)args.Item;
    /// Gather the correct ID and correct the original item's ID
    /// Must use original item to activate edit mode
    var createdItem = await AirHornService.CreateTransaction(draftItem);
    draftItem.TransactionID = createdItem.TransactionID;
    MyData.Insert(0, draftItem);
  }

  async Task DeleteHandler(GridCommandEventArgs args)
  {
    Console.WriteLine("Delete event is fired.");
    Transaction item = (Transaction)args.Item;
    await AirHornService.DeleteTransaction(item.TransactionID);
    await GetGridData();
  }

  async Task EditHandler(GridCommandEventArgs args)
  {
    Console.WriteLine("Edit event is fired.");
  }

  async Task UpdateHandler(GridCommandEventArgs args)
  {
    Console.WriteLine("Update event is fired.");
    Transaction item = (Transaction)args.Item;
    await AirHornService.UpdateTransaction(item.TransactionID, item);
    await GetGridData();
  }

  private async Task CustomAdd()
  {
    var gridState = GridRef.GetState();
    var insertedProduct = new Transaction()
    {
      TransactionID = 0,
      Name = FilterName ?? String.Empty,
      Date = DateOnly.FromDateTime(DateTime.Now),
      Amount = -1,
      Note = ""
    };
    await CreateHandler(new GridCommandEventArgs()
    {
      Item = insertedProduct
    });
    gridState.OriginalEditItem = insertedProduct;
    gridState.EditItem = insertedProduct.Clone();
    gridState.EditField = nameof(Transaction.Name);
    await GridRef.SetStateAsync(gridState);
  }


  async Task GetGridData()
  {
    MyData = (await AirHornService.GetTransactions()).ToList();
  }

  private async Task SetGridOptions()
  {
    GridState<Transaction> desiredState = new GridState<Transaction>()
    {
      FilterDescriptors = new List<IFilterDescriptor>()
      {
        new CompositeFilterDescriptor()
        {
          FilterDescriptors = new FilterDescriptorCollection()
          {
            new FilterDescriptor() { Member = "Name", Operator = FilterOperator.IsEqualTo, Value = FilterName, MemberType = typeof(string)}
          }
        }
      }
    };
    var sortDescriptors = new List<SortDescriptor>();
    sortDescriptors.Add(new SortDescriptor() { Member = "Date", SortDirection = ListSortDirection.Descending });
    sortDescriptors.Add(new SortDescriptor() { Member = "TransactionID", SortDirection = ListSortDirection.Descending });
    desiredState.SortDescriptors = sortDescriptors;
    await GridRef.SetStateAsync(desiredState);
  }

  // Form DTO
  private sealed class AddTxForm
  {
    [System.ComponentModel.DataAnnotations.Required]
    public decimal? Amount { get; set; }

    public string? Note { get; set; }

    [System.ComponentModel.DataAnnotations.Required]
    public DateOnly Date { get; set; } = DateOnly.FromDateTime(DateTime.Today);
  }
}
